+// connectContext keeps the original authentication/setup implementation but
+// interrupts the setup socket on cancellation or a fixed deadline.
+func (c *Conn) connectContext(ctx context.Context, display string) error {
+	if err := c.dialContext(ctx, display); err != nil {
+		return err
+	}
+	return c.handshakeContext(ctx)
+}
+
+// handshakeContext runs the bounded setup over an already established socket.
+func (c *Conn) handshakeContext(ctx context.Context) error {
+	stop := context.AfterFunc(ctx, func() { _ = c.conn.Close() })
+	deadline, _ := ctx.Deadline()
+	if err := c.conn.SetDeadline(deadline); err != nil {
+		stop()
+		_ = c.conn.Close()
+		return err
+	}
+	err := c.postConnect("")
+	stop()
+	_ = c.conn.SetDeadline(time.Time{})
+	if err != nil {
+		_ = c.conn.Close()
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return ctxErr
+		}
+		var timedOut net.Error
+		if errors.As(err, &timedOut) && timedOut.Timeout() {
+			return context.DeadlineExceeded
+		}
+		return err
+	}
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		_ = c.conn.Close()
+		return ctxErr
+	}
+	return nil
+}
