#!/usr/bin/env bash
# Opt-in verification of the INSTALLED Flatpak in a real visible Wayland session.
# Portal consent is deliberately not faked or bypassed.
set -euo pipefail
usage() {
  cat <<'USAGE'
Usage: pf-flatpak-attended-check MODE

MODE:
  allow    Approve RemoteDesktop input; type and save a marker
  deny     Deny a fresh request; ensure no input is injected
  cancel   Cancel a portal request; ensure no input is injected
  restore  Opt in to restoring permission; type and save twice
  revoke   Revoke authorization in settings, then deny a new request
  bridge   With GNOME host bridge installed, verify native window control
  capture         Approve an attended screenshot; validate a disposable PNG
  capture-deny    Deny screenshot permission; ensure no image is returned
  capture-cancel  Cancel screenshot permission; ensure no image is returned

Requires a visible GNOME or KDE Wayland session and an interactive terminal.
Uses disposable files only; never modifies an existing document.
USAGE
}
if [[ "$#" -ne 1 || "$1" == "--help" || "$1" == "-h" ]]; then
  usage
  [[ "$#" -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]
  exit $?
fi
mode="$1"
case "$mode" in allow|deny|restore|revoke|cancel|bridge|capture|capture-deny|capture-cancel) ;; *) usage >&2; exit 2;; esac
if [[ ! -t 0 || "${XDG_SESSION_TYPE:-}" != "wayland" || -z "${WAYLAND_DISPLAY:-}" ]]; then
  echo "An attended, visible Wayland desktop and interactive terminal are required." >&2
  exit 2
fi
if ! command -v flatpak >/dev/null || ! flatpak info io.github.nskaggs.perfuncted >/dev/null 2>&1; then
  echo "Install the single perfuncted.flatpak bundle before running attended checks." >&2
  exit 2
fi
desktop="${XDG_CURRENT_DESKTOP:-}"
if [[ "$mode" == "capture" || "$mode" == "capture-deny" || "$mode" == "capture-cancel" ]]; then
  case "${desktop,,}" in
    *kde*|*plasma*|*gnome*) ;;
    *) echo "Use a visible KDE Plasma or GNOME Wayland session." >&2; exit 2 ;;
  esac
  if ! command -v python3 >/dev/null; then
    echo "python3 is required to validate captured PNG bytes." >&2
    exit 2
  fi
  tmpdir="$(mktemp -d "${XDG_RUNTIME_DIR:-/var/tmp}/pf-flatpak-attended.XXXXXXXX")"
  trap 'rm -rf -- "$tmpdir"' EXIT
  capture="$tmpdir/consented-screenshot.png"
  echo "Session: $desktop / Wayland"
  echo "A screenshot portal may request your authorization to capture screen pixels."
  echo "The 64x48 PNG is stored only in a disposable private directory and deleted on exit."
  case "$mode" in
    capture-deny) echo "Deny the screenshot portal request when prompted." ;;
    capture-cancel) echo "Cancel or dismiss the screenshot portal request when prompted." ;;
    *) echo "Approve the screenshot portal request when prompted." ;;
  esac
  read -r -p "Press Enter to request the screenshot with the installed Flatpak: " _
  if [[ "$mode" != "capture" ]]; then
    # A denial is a failure only if the program returns nonzero AND no pixels
    # escape to stdout. The human tester must confirm the actual dialog was
    # denied/canceled rather than merely absent or broken.
    if flatpak run io.github.nskaggs.perfuncted screen grab --rect=0,0,64,48 --out - > "$capture"; then
      echo "FAIL: screenshot capture succeeded despite expected denial/cancellation." >&2
      exit 1
    fi
    if [[ -s "$capture" ]]; then
      echo "FAIL: screenshot bytes escaped despite denied/canceled capture." >&2
      exit 1
    fi
    echo "PASS: screenshot command failed closed without returning pixels; confirm the portal request was denied or canceled as instructed."
    exit 0
  fi
  if ! flatpak run io.github.nskaggs.perfuncted screen grab --rect=0,0,64,48 --out - > "$capture"; then
    echo "FAIL: screenshot capture was denied or unavailable." >&2
    exit 1
  fi
  python3 - "$capture" <<'PYPNG'
import pathlib
import struct
import sys
import zlib


def reject(message):
    sys.exit("FAIL: invalid or incomplete 64x48 screenshot PNG: " + message)


raw = pathlib.Path(sys.argv[1]).read_bytes()
if not raw.startswith(b"\x89PNG\r\n\x1a\n"):
    reject("signature")
pos = 8
has_header = has_data = has_end = False
pixels = bytearray()
while pos + 12 <= len(raw):
    size = struct.unpack_from(">I", raw, pos)[0]
    if size > len(raw) - pos - 12:
        reject("truncated chunk")
    kind = raw[pos + 4:pos + 8]
    payload = raw[pos + 8:pos + 8 + size]
    crc = struct.unpack_from(">I", raw, pos + 8 + size)[0]
    if zlib.crc32(kind + payload) != crc:
        reject("chunk CRC")
    pos += size + 12
    if not has_header:
        if kind != b"IHDR" or size != 13:
            reject("missing IHDR")
        width, height, depth, color, compression, filtering, interlace = struct.unpack(">IIBBBBB", payload)
        if (width, height) != (64, 48):
            reject("unexpected image dimensions")
        channels = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}.get(color)
        allowed_depths = {0: (1, 2, 4, 8, 16), 2: (8, 16), 3: (1, 2, 4, 8), 4: (8, 16), 6: (8, 16)}
        if channels is None or depth not in allowed_depths[color] or compression or filtering or interlace not in (0, 1):
            reject("unsupported PNG encoding")
        has_header = True
    elif kind == b"IHDR":
        reject("duplicate IHDR")
    elif kind == b"IDAT":
        if has_end:
            reject("IDAT after IEND")
        has_data = True
        pixels.extend(payload)
    elif kind == b"IEND":
        if size != 0 or not has_data or pos != len(raw):
            reject("invalid IEND or trailing bytes")
        has_end = True
        break
    elif kind[0] & 0x20 == 0:
        reject("unsupported critical chunk")

if not (has_header and has_data and has_end):
    reject("missing image data or IEND")
try:
    decoder = zlib.decompressobj()
    # A 64x48 screenshot has fewer than 40 KiB of unfiltered pixels even
    # with 16-bit RGBA and Adam7 pass headers. Reject oversized expansion.
    decoded = decoder.decompress(bytes(pixels), 64 * 1024)
except zlib.error:
    reject("corrupt compressed pixels")
if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:
    reject("incomplete or excess compressed pixels")

# Verify every scanline, including PNG filter bytes. For Adam7-encoded
# images, compute the seven passes separately.
passes = ((0, 0, 1, 1),) if interlace == 0 else (
    (0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4),
    (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2),
)
offset = 0
for x0, y0, dx, dy in passes:
    pw = max(0, (width - x0 + dx - 1) // dx)
    ph = max(0, (height - y0 + dy - 1) // dy)
    if pw == 0 or ph == 0:
        continue
    stride = (pw * channels * depth + 7) // 8
    for _ in range(ph):
        if offset + stride + 1 > len(decoded) or decoded[offset] > 4:
            reject("invalid or truncated scanline")
        offset += stride + 1
if offset != len(decoded):
    reject("unexpected scanline length")
PYPNG
  echo "PASS: installed Flatpak captured a validated 64x48 PNG in an attended $desktop Wayland session."
  exit 0
fi
case "${desktop,,}" in
  *kde*|*plasma*) editor=kwrite ;;
  *gnome*) editor=gnome-text-editor ;;
  *) echo "Use a visible KDE Plasma or GNOME Wayland session." >&2; exit 2 ;;
esac
if ! command -v "$editor" >/dev/null; then
  echo "Install $editor to supply a native Wayland document target." >&2
  exit 2
fi
tmpdir="$(mktemp -d "${XDG_RUNTIME_DIR:-/var/tmp}/pf-flatpak-attended.XXXXXXXX")"
trap 'rm -rf -- "$tmpdir"' EXIT
document="$tmpdir/portal-document.txt"
: > "$document"
case "$editor" in
  kwrite) QT_QPA_PLATFORM=wayland kwrite "$document" >/dev/null 2>&1 & ;;
  gnome-text-editor) GDK_BACKEND=wayland gnome-text-editor "$document" >/dev/null 2>&1 & ;;
esac
echo "Session: $desktop / Wayland"
echo "Target: a NEW, EMPTY temporary $editor document ($document)"
flatpak run io.github.nskaggs.perfuncted version
flatpak run io.github.nskaggs.perfuncted info --output=json > "$tmpdir/capabilities.json"
manual_focus() {
  echo "After Enter, focus the blank editor window within three seconds."
  read -r -p "Press Enter when ready to focus the editor: " _
  sleep 3
}
send_portal() {
  local flags=(--input-backend remote-desktop)
  if [[ "$mode" == "restore" ]]; then flags+=(--remember-input-permission); fi
  flatpak run io.github.nskaggs.perfuncted "${flags[@]}" input type "$1"
}
marker="perfuncted-portal-$(date -u +%Y%m%d%H%M%S)-$$"
case "$mode" in
  allow|restore)
    echo "Approve the compositor's RemoteDesktop request when it appears."
    echo "Select a coordinate within the editor's blank TEXT AREA, not its titlebar."
    read -r -p "Desktop pixel coordinates (X Y): " click_x click_y
    if [[ ! "$click_x" =~ ^[0-9]+$ || ! "$click_y" =~ ^[0-9]+$ ]]; then
      echo "Coordinates must be nonnegative integers." >&2
      exit 2
    fi
    manual_focus
    flags=(--input-backend remote-desktop)
    if [[ "$mode" == "restore" ]]; then flags+=(--remember-input-permission); fi
    flatpak run io.github.nskaggs.perfuncted "${flags[@]}" input click --x "$click_x" --y "$click_y"
    send_portal "$marker"
    send_portal '{ctrl+s}'
    if [[ "$mode" == "restore" ]]; then
      send_portal 'restored'
      send_portal '{ctrl+s}'
      marker="${marker}restored"
    fi
    if ! grep -Fxq -- "$marker" "$document"; then
      echo "FAIL: input was reported but the native editor did not save expected text." >&2
      printf 'Saved content: '; cat "$document" >&2
      exit 1
    fi
    echo "PASS: native Wayland editor received authorized input and saved the exact marker."
    ;;
  deny|revoke|cancel)
    if [[ "$mode" == "revoke" ]]; then
      echo "Revoke Perfuncted RemoteDesktop authorization in desktop settings first."
      read -r -p "Press Enter after revocation: " _
    fi
    if [[ "$mode" == "cancel" ]]; then
      echo "Cancel/dismiss the RemoteDesktop request when prompted."
    else
      echo "Deny the RemoteDesktop request when the compositor prompts."
    fi
    manual_focus
    if send_portal "$marker"; then
      echo "FAIL: denied/revoked RemoteDesktop input unexpectedly succeeded." >&2
      exit 1
    fi
    if [[ -s "$document" ]]; then
      echo "FAIL: document changed after denied input." >&2
      exit 1
    fi
    echo "PASS: rejected/canceled/revoked permission failed closed without modifying the document."
    ;;
  bridge)
    if [[ "${desktop,,}" != *gnome* ]]; then
      echo "GNOME host bridge verification requires an attended GNOME Wayland desktop." >&2
      exit 2
    fi
    echo "The GNOME native host extension must already be installed and loaded."
    manual_focus
    if ! flatpak run io.github.nskaggs.perfuncted window list | grep -F 'portal-document.txt'; then
      echo "FAIL: GNOME native bridge did not discover the editor's visible window." >&2
      exit 1
    fi
    flatpak run io.github.nskaggs.perfuncted window activate 'portal-document.txt' --verify
    echo "PASS: GNOME host bridge enumerated and activated the native editor window."
    ;;
esac
echo "Tested installed Flatpak on $desktop Wayland, mode=$mode."
